{
  "$id": "urn:k-arc:e11-base3:turn:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "not": {
    "anyOf": [
      {
        "required": [
          "argv"
        ]
      },
      {
        "required": [
          "command"
        ]
      },
      {
        "required": [
          "compaction_text"
        ]
      },
      {
        "required": [
          "credential"
        ]
      },
      {
        "required": [
          "cwd"
        ]
      },
      {
        "required": [
          "environment"
        ]
      },
      {
        "required": [
          "history_text"
        ]
      },
      {
        "required": [
          "output"
        ]
      },
      {
        "required": [
          "output_text"
        ]
      },
      {
        "required": [
          "prompt"
        ]
      },
      {
        "required": [
          "tool_response"
        ]
      },
      {
        "required": [
          "transcript"
        ]
      }
    ]
  },
  "properties": {
    "api_cache_read_tokens": {
      "minimum": 0,
      "type": "integer"
    },
    "api_input_tokens_no_cache": {
      "minimum": 0,
      "type": "integer"
    },
    "api_input_tokens_with_cache": {
      "minimum": 0,
      "type": "integer"
    },
    "api_output_tokens": {
      "minimum": 0,
      "type": "integer"
    },
    "api_reasoning_tokens": {
      "minimum": 0,
      "type": "integer"
    },
    "arm": {
      "enum": [
        "full-history",
        "sliding-window-compaction",
        "stateless-rag"
      ]
    },
    "compaction_summary_calls": {
      "const": 0
    },
    "discarded_prior_turns": {
      "maximum": 15,
      "minimum": 0,
      "type": "integer"
    },
    "failure_class": {
      "type": "string"
    },
    "history_turns_supplied": {
      "maximum": 15,
      "minimum": 0,
      "type": "integer"
    },
    "infra_failure_attempts": {
      "minimum": 0,
      "type": "integer"
    },
    "mcp_get_calls": {
      "const": 0
    },
    "mcp_search_calls": {
      "const": 0
    },
    "model_spend_attempts": {
      "maximum": 3,
      "minimum": 0,
      "type": "integer"
    },
    "passed": {
      "type": "boolean"
    },
    "position": {
      "maximum": 16,
      "minimum": 1,
      "type": "integer"
    },
    "privacy": {
      "const": "normalized-no-content"
    },
    "prompt_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "provider_session_reused": {
      "type": "boolean"
    },
    "retrieval_mode": {
      "enum": [
        "none-full-corpus-injected",
        "frozen-bm25-current-turn"
      ]
    },
    "schema": {
      "const": "e11-base3-turn-v1"
    },
    "session_id": {
      "pattern": "^S[0-9]{2}$",
      "type": "string"
    },
    "session_mode": {
      "enum": [
        "persistent-unbounded",
        "rebuilt-bounded-window",
        "isolated-per-turn"
      ]
    },
    "task_id": {
      "type": "string"
    }
  },
  "required": [
    "schema",
    "arm",
    "session_id",
    "position",
    "task_id",
    "failure_class",
    "passed",
    "session_mode",
    "history_turns_supplied",
    "discarded_prior_turns",
    "compaction_summary_calls",
    "retrieval_mode",
    "provider_session_reused",
    "model_spend_attempts",
    "infra_failure_attempts",
    "api_input_tokens_no_cache",
    "api_input_tokens_with_cache",
    "api_cache_read_tokens",
    "api_output_tokens",
    "api_reasoning_tokens",
    "mcp_search_calls",
    "mcp_get_calls",
    "prompt_sha256",
    "privacy"
  ],
  "title": "E11-BASE3 normalized turn row",
  "type": "object"
}
